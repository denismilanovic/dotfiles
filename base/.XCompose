# GTK has rewritten this file to add the line:

include "%L"

# This is necessary to add your own Compose sequences
# in addition to the builtin sequences of GTK. If this
# is not what you want, just remove that line.
#
# A backup of the previous file contents has been made.


# Emoji and Symbols
<Multi_key> <f> <u>                           : "🖕"
<Multi_key> <c> <c> <c> <p>                   : "☭"	
<Multi_key> <p> <o> <o>                       : "💩"
<Multi_key> <l> <l> <a> <p>                   : "🖖"
<Multi_key> <backslash> <o> <slash>           : "🙌"
<Multi_key> <less> <3>                        : "♥"
<Multi_key> <colon> <apostrophe> <parenright> : "😂"

# Greek Letters
<Multi_key> <a> <l> <p> <h> <a>               : "α"
<Multi_key> <b> <e> <t> <a>                   : "β"
<Multi_key> <g> <a> <m> <m> <a>               : "γ"
<Multi_key> <G> <A> <M> <M> <A>               : "Γ"
<Multi_key> <d> <e> <l> <t> <a>               : "δ"
<Multi_key> <D> <E> <L> <T> <A>               : "Δ"
<Multi_key> <l> <a> <m> <b> <d> <a>           : "λ"
<Multi_key> <L> <A> <M> <B> <D> <A>           : "Λ"
<Multi_key> <m> <u>                           : "μ"
<Multi_key> <p> <i>                           : "π"
<Multi_key> <P> <I>                           : "Π"

# Mathematical Symbols
<Multi_key> <s> <u> <m>                       : "∑"
<Multi_key> <+> <->                           : "±"
<Multi_key> <~> <=>                           : "≈"
<Multi_key> <i> <n> <f>                       : "∞"
<Multi_key> <s> <q> <r> <t>                   : "√"
<Multi_key> <i> <n> <t>                       : "∫"
